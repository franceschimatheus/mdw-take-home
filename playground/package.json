{
  "name": "mdw-take-home-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Inngest function that emails a movie's plot summary (OMDb + Resend) when a movie.watched event arrives.",
  "scripts": {
    "dev": "next dev",
    "dev:inngest": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "email:dev": "email dev --dir src/features/movies/emails --port 3001",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.1",
    "@phosphor-icons/react": "2.1.10",
    "@react-email/components": "1.0.12",
    "@tanstack/react-query": "5.105.0",
    "clsx": "2.1.1",
    "inngest": "4.26.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "resend": "6.34.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "inngest-cli": "1.49.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react-email": "6.11.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
