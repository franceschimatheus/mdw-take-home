# OMDb API key (https://www.omdbapi.com/apikey.aspx).
OMDB_API_KEY=

# Resend API key (https://resend.com/api-keys).
RESEND_API_KEY=

# Sender address. Without a verified domain, Resend only delivers
# `onboarding@resend.dev` emails to the account owner's address.
EMAIL_FROM="Meadow <onboarding@resend.dev>"

# Local development only (docker compose sets it for you): talk to the Inngest Dev Server (localhost:8288)
# instead of Inngest Cloud. In production, set INNGEST_SIGNING_KEY and
# INNGEST_EVENT_KEY instead.
INNGEST_DEV=1

# Optional: pre-fills and locks the form's email field to this address.
# Without a verified domain, Resend only delivers to the account owner's email,
# so set this to the address you signed up to Resend with.
RESEND_OWNER_EMAIL=

# Optional: public URL of the deployed site, used for canonical, Open Graph and
# sitemap links. Defaults to http://localhost:3000.
SITE_URL=
